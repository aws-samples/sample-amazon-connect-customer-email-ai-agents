@startuml architecture-email-ai-agents

!define AWSPuml https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v18.0/dist
!include AWSPuml/AWSCommon.puml
!include AWSPuml/AWSSimplified.puml
!include AWSPuml/BusinessApplications/AmazonConnect.puml
!include AWSPuml/BusinessApplications/AmazonSimpleEmailService.puml
!include AWSPuml/Storage/AmazonSimpleStorageService.puml
!include AWSPuml/General/User.puml
!include AWSPuml/General/Users.puml

skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

title Amazon Connect Email AI Agents - Architecture

' Actors
User(customer, "Customer", "Sends email")
User(agent, "Contact Center Agent", "Reviews AI suggestions")

' AWS Services
AmazonSimpleEmailService(ses, "Amazon SES", "Receives inbound email")
AmazonConnect(connect, "Amazon Connect\nEmail Channel", "Routes email contacts")
AmazonSimpleStorageService(s3email, "Amazon S3\n(Email Storage)", "Stores messages\n& attachments")
AmazonSimpleStorageService(s3kb, "Amazon S3\n(Knowledge Base)", "Policy documents\nFAQs, procedures")
' Note: the AI agents domain is a native Amazon Connect resource. Do not use the
' Amazon Bedrock icon here - no separate Bedrock setup is required for this solution.
AmazonConnect(aiagents, "Amazon Connect\nAI Agents Domain", "EmailOverview\nEmailResponse\nEmailGenerativeAnswer")

rectangle "Contact Flow" as flow {
  card "Check\nChannel" as check
  card "Connect\nAssistant\n(Create Session)" as assistant
  card "Spam\nCheck" as spam
  card "Queue\nRouting" as queue
}

rectangle "Agent Workspace" as workspace {
  card "Email\nOverview" as overview
  card "KB\nRecommendations" as kbrec
  card "Draft\nReply" as draft
}

' Relationships
customer -right-> ses : "Inbound email"
ses -right-> connect : "Email contact"
connect -down-> s3email : "Store email\n& attachments"
connect -right-> flow

check -right-> assistant
assistant -right-> spam
spam -right-> queue
queue -down-> agent

assistant -down-> aiagents : "Associate\ndomain"
s3kb -up-> aiagents : "Knowledge base\ncontent ingestion"

agent -right-> workspace : "Accepts contact\n(AI fires)"
aiagents -right-> workspace : "Generates\nsuggestions"

@enduml
